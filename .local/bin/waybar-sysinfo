#!/bin/sh
# System stats for Waybar — adapted from BreadOnPenguins/scripts statusbar/systemstats.
# Upstream: dwmblocks text output + notify-send on click.
# This version: Waybar JSON with tooltip for the detail view.

SENSORS_OUT=$(sensors 2>/dev/null)

# --- CPU temp (upstream pattern: Tctl / Tdie / Package id / Core 0 / temp1) ---
CPU_TEMP=$(printf '%s\n' "$SENSORS_OUT" | awk '
    /^Tctl|^Tdie|^Package id|^Core 0|^temp1/ {
        gsub(/[+°C]/, "")
        for (i = 1; i <= NF; i++)
            if ($i ~ /^[0-9]+(\.[0-9]+)?$/) { gsub(/\..*/, "", $i); print $i; exit }
    }')
[ -z "$CPU_TEMP" ] && CPU_TEMP="N/A"

# --- GPU temp (upstream: nvidia-smi or AMD edge/junction) ---
GPU_TEMP=$(printf '%s\n' "$SENSORS_OUT" | awk '/^edge/ { gsub(/\+/, ""); gsub(/\..*/, "", $2); print $2; exit }')
[ -z "$GPU_TEMP" ] && GPU_TEMP="N/A"

# --- NVMe temp ---
NVME_TEMP=$(printf '%s\n' "$SENSORS_OUT" | awk '/^Composite:/ { gsub(/[+°C]/, ""); gsub(/\..*/, "", $2); print $2; exit }')
[ -z "$NVME_TEMP" ] && NVME_TEMP="N/A"

# --- Memory (upstream pattern) ---
MEM_USED=$(free -m | awk '/^Mem/ { printf "%.1f", $3 / 1024 }')
MEM_TOTAL=$(free -m | awk '/^Mem/ { printf "%.1f", $2 / 1024 }')

# --- CPU usage ---
CPU_USE=$(awk '/^cpu / { idle = $5; total = 0; for (i = 2; i <= NF; i++) total += $i; printf "%.0f", 100 * (1 - idle / total) }' /proc/stat)

# --- Load average ---
LOAD=$(cut -d' ' -f1-3 /proc/loadavg)

# --- Uptime ---
UP=$(uptime -p | sed 's/^up //')

# --- Disk ---
DISK=$(df -h / | awk 'NR==2 { printf "%s free / %s (%s)", $4, $2, $5 }')

# --- Power ---
POWER=$(upower -i /org/freedesktop/UPower/devices/battery_BAT1 2>/dev/null | awk -F':[[:space:]]*' '/energy-rate:/ {printf "%.1f W", $2; exit}')
[ -z "$POWER" ] && POWER="N/A"

# --- Bar text: display ONLY the icon  ---
TEXT=""

# --- Tooltip: full system monitoring detail view ---
TOOLTIP="CPU: ${CPU_USE}%  ${CPU_TEMP}°C\nGPU: ${GPU_TEMP}°C\nNVMe: ${NVME_TEMP}°C\nRAM: ${MEM_USED}/${MEM_TOTAL} GiB\nDisk: ${DISK}\nPower: ${POWER}\nLoad: ${LOAD}\nUp: ${UP}"
# --- Waybar JSON ---
printf '{"text": "%s", "tooltip": "%s"}\n' "$TEXT" "$TOOLTIP"
