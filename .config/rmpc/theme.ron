#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    show_song_table_header: false,
    draw_borders: true,
    format_tag_separator: " | ",
    song_table_album_separator: Underline,
    browser_column_widths: [20, 38, 42],
    background_color: None,
    text_color: Some("#d7e6e8"),
    header_background_color: None,
    modal_background_color: None,
    modal_backdrop: false,
    preview_label_style: (fg: "#76c4e0"),
    preview_metadata_group_style: (fg: "#72d7ce", modifiers: "Bold"),
    highlighted_item_style: (fg: "#72d7ce", modifiers: "Bold"),
    current_item_style: (fg: "#07191c", bg: "#72d7ce", modifiers: "Bold"),
    borders_style: (fg: "#27535a"),
    highlight_border_style: (fg: "#72d7ce"),
    symbols: (
        song: "󰝚 ",
        dir: " ",
        playlist: "󰲂 ",
        marker: "* ",
        ellipsis: "...",
        song_style: None,
        dir_style: None,
        playlist_style: None,
    ),
    level_styles: (
        info: (fg: "#72d7ce", bg: "#07191c"),
        warn: (fg: "#e2ca7b", bg: "#07191c"),
        error: (fg: "#e48786", bg: "#07191c"),
        debug: (fg: "#75d4af", bg: "#07191c"),
        trace: (fg: "#76c4e0", bg: "#07191c"),
    ),
    progress_bar: (
        symbols: ["█", "█", "█", " ", "█"],
        track_style: (fg: "#27535a"),
        elapsed_style: (fg: "#72d7ce"),
        thumb_style: (fg: "#75d4af"),
        use_track_when_empty: true,
    ),
    scrollbar: (
        symbols: ["", "", "", ""],
        track_style: (fg: "#102b2f"),
        ends_style: (fg: "#76c4e0"),
        thumb_style: (fg: "#72d7ce"),
    ),
    tab_bar: (
        enabled: true,
        active_style: (fg: "#07191c", bg: "#72d7ce", modifiers: "Bold"),
        inactive_style: (fg: "#b9d4d6", bg: "#102b2f"),
    ),
    lyrics: (
        timestamp: false
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist)),
                (kind: Text(" - ")),
                (kind: Property(Title)),
            ]),
            default: (kind: Property(Filename))
        ),
    ],
    song_table_format: [
        (
            prop: (kind: Property(Title),
                style: (fg: "#4ea5ca"),
                highlighted_item_style: (fg: "#07191c", modifiers: "Bold"),
                default: (kind: Property(Filename), style: (fg: "#527177"))
            ),
            width: "70%",
        ),
        (
            prop: (kind: Property(Album), style: (fg: "#d7e6e8"),
                default: (kind: Text("Unknown Album"), style: (fg: "#76c4e0"))
            ),
            width: "30%",
        ),
    ],
    layout: Split(
        direction: Vertical,
        panes: [
            (
                size: "3",
                pane: Pane(Tabs),
            ),
            (
                size: "4",
                pane: Split(
                    direction: Vertical,
                    panes: [
                        (
                            size: "2",
                            pane: Split(
                                direction: Horizontal,
                                panes: [
                                    (size: "25%", pane: Component("header_state")),
                                    (size: "50%", pane: Component("header_title")),
                                    (size: "25%", pane: Component("header_volume")),
                                ],
                            ),
                        ),
                        (
                            size: "2",
                            pane: Split(
                                direction: Horizontal,
                                panes: [
                                    (size: "25%", pane: Component("header_time")),
                                    (size: "50%", pane: Component("header_artist")),
                                    (size: "25%", pane: Component("header_states")),
                                ],
                            ),
                        ),
                    ],
                ),
            ),
            (
                pane: Pane(TabContent),
                size: "100%",
            ),
            (
                size: "3",
                pane: Split(
                    direction: Vertical,
                    panes: [
                        (size: "2", pane: Pane(ProgressBar)),
                        (size: "1", pane: Component("footer")),
                    ],
                ),
            ),
        ],
    ),
    components: {
        "state": Pane(Property(
            content: [
                (kind: Text("["), style: (fg: "#72d7ce", modifiers: "Bold")),
                (kind: Property(Status(StateV2( ))), style: (fg: "#72d7ce", modifiers: "Bold")),
                (kind: Text("]"), style: (fg: "#72d7ce", modifiers: "Bold")),
            ], align: Left,
        )),
        "title": Pane(Property(
            content: [
                (kind: Property(Song(Title)), style: (modifiers: "Bold"),
                    default: (kind: Text("No Song"), style: (modifiers: "Bold"))),
            ], align: Center, scroll_speed: 1
        )),
        "volume": Split(
            direction: Horizontal,
            panes: [
                (size: "1", pane: Pane(Property(content: [(kind: Text(""))]))),
                (size: "100%", pane: Pane(Volume(kind: Slider(symbols: (filled: "─", thumb: "●", track: "─"))))),
                (size: "3", pane: Pane(Property(content: [(kind: Property(Status(Volume)), style: (fg: "#76c4e0"))], align: Right))),
                (size: "2", pane: Pane(Property(content: [(kind: Text("%"), style: (fg: "#76c4e0"))]))),
            ]
        ),
        "elapsed_and_bitrate": Pane(Property(
            content: [
                (kind: Property(Status(Elapsed))), 
                (kind: Text(" / ")), 
                (kind: Property(Status(Duration))), 
                (kind: Group([
                    (kind: Text(" (")), 
                    (kind: Property(Status(Bitrate))), 
                    (kind: Text(" kbps)")),
                ])),
            ],
            align: Left,
        )),
        "artist_and_album": Pane(Property(
            content: [
                (kind: Property(Song(Artist)), style: (fg: "#75d4af", modifiers: "Bold"),
                    default: (kind: Text("Unknown"), style: (fg: "#75d4af", modifiers: "Bold"))),
                (kind: Text(" - ")),
                (kind: Property(Song(Album)), default: (kind: Text("Unknown Album"))),
            ], align: Center, scroll_speed: 1
        )),
        "states": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
                (
                    size: "100%",
                    pane: Pane(Property(content: [(kind: Property(Status(InputBuffer())), style: (fg: "#72d7ce"), align: Left)]))
                ),
                (
                    size: "6",
                    pane: Pane(Property(content: [
                        (kind: Text("["), style: (fg: "#72d7ce", modifiers: "Bold")),
                        (kind: Property(Status(RepeatV2(
                            on_label: "z",
                            off_label: "z",
                            on_style: (fg: "#e2ca7b", modifiers: "Bold"),
                            off_style: (fg: "#76c4e0", modifiers: "Dim"),
                        )))),
                        (kind: Property(Status(RandomV2(
                            on_label: "x",
                            off_label: "x",
                            on_style: (fg: "#e2ca7b", modifiers: "Bold"),
                            off_style: (fg: "#76c4e0", modifiers: "Dim"),
                        )))),
                        (kind: Property(Status(ConsumeV2(
                            on_label: "c",
                            off_label: "c",
                            oneshot_label: "c",
                            on_style: (fg: "#e2ca7b", modifiers: "Bold"),
                            off_style: (fg: "#76c4e0", modifiers: "Dim"),
                            oneshot_style: (fg: "#e48786", modifiers: "Dim"),
                        )))),
                        (kind: Property(Status(SingleV2(
                            on_label: "v",
                            off_label: "v",
                            oneshot_label: "v",
                            on_style: (fg: "#e2ca7b", modifiers: "Bold"),
                            off_style: (fg: "#76c4e0", modifiers: "Dim"),
                            oneshot_style: (fg: "#e48786", modifiers: "Bold"),
                        )))),
                        (kind: Text("]"), style: (fg: "#72d7ce", modifiers: "Bold")),
                        ],
                        align: Right
                    ))
                ),
            ]
        ),
        "input_mode": Pane(Property(
            content: [
                (kind: Transform(Replace(content: (kind: Property(Status(InputMode()))), replacements: [
                    (match: "Normal", replace: (kind: Text(" NORMAL "), style: (fg: "#07191c", bg: "#72d7ce"))),
                    (match: "Insert", replace: (kind: Text(" INSERT "), style: (fg: "#07191c", bg: "#75d4af"))),
                ])))
            ], align: Center
        )),
        "header_state": Pane(Property(
            content: [
                (kind: Property(Status(StateV2(
                    playing_label: "▶ ",
                    paused_label: "Ⅱ ",
                    stopped_label: "■ "
                ))), style: (fg: "#72d7ce", modifiers: "Bold")),
            ], align: Left,
        )),
        "header_title": Pane(Property(
            content: [
                (kind: Property(Song(Title)), style: (fg: "#effafa", modifiers: "Bold"),
                    default: (kind: Property(Song(Filename)), style: (fg: "#effafa", modifiers: "Bold")))
            ], align: Center, scroll_speed: 1,
        )),
        "header_volume": Pane(Property(
            content: [
                (kind: Text("Vol: "), style: (fg: "#72d7ce", modifiers: "Bold")),
                (kind: Property(Status(Volume)), style: (fg: "#72d7ce", modifiers: "Bold")),
                (kind: Text("% "), style: (fg: "#72d7ce", modifiers: "Bold")),
            ], align: Right,
        )),
        "header_time": Pane(Property(
            content: [
                (kind: Property(Status(Elapsed)), style: (fg: "#d7e6e8")),
                (kind: Text(" / "), style: (fg: "#527177")),
                (kind: Property(Status(Duration)), style: (fg: "#d7e6e8")),
            ], align: Left,
        )),
        "header_artist": Pane(Property(
            content: [
                (kind: Property(Song(Artist)), style: (fg: "#75d4af", modifiers: "Bold"),
                    default: (kind: Text("Unknown Artist"), style: (fg: "#e48786", modifiers: "Bold")))
            ], align: Center, scroll_speed: 1,
        )),
        "header_states": Pane(Property(
            content: [
                (kind: Property(Status(RepeatV2(
                    on_label: "R", off_label: "r",
                    on_style: (fg: "#e2ca7b", modifiers: "Bold"),
                    off_style: (fg: "#76c4e0", modifiers: "Dim"),
                )))),
                (kind: Property(Status(RandomV2(
                    on_label: "X", off_label: "x",
                    on_style: (fg: "#e2ca7b", modifiers: "Bold"),
                    off_style: (fg: "#76c4e0", modifiers: "Dim"),
                )))),
            ], align: Right,
        )),
        "footer": Pane(Property(
            content: [
                (kind: Text("Queue "), style: (fg: "#72d7ce", modifiers: "Bold")),
                (kind: Property(Status(QueueLength(thousands_separator: ","))), style: (fg: "#d7e6e8")),
                (kind: Text(" tracks  ·  "), style: (fg: "#527177")),
                (kind: Property(Status(QueueTimeTotal())), style: (fg: "#d7e6e8")),
                (kind: Text("  ·  "), style: (fg: "#527177")),
                (kind: Text("Bitrate "), style: (fg: "#72d7ce", modifiers: "Bold")),
                (kind: Property(Status(Bitrate)), style: (fg: "#d7e6e8")),
                (kind: Text(" kbps"), style: (fg: "#527177")),
            ], align: Center,
        )),
        "header_left": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("state")),
                (size: "1", pane: Component("elapsed_and_bitrate")),
            ]
        ),
        "header_center": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("title")),
                (size: "1", pane: Component("artist_and_album")),
            ]
        ),
        "header_right": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("volume")),
                (size: "1", pane: Component("states")),
            ]
        ),
        "progress_bar": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
                (
                    size: "100%",
                    pane: Pane(ProgressBar)
                ),
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
            ]
        )
    },
)
